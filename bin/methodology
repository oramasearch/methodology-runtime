#!/bin/sh
# The methodology command. In the image this is /opt/orama/bin/methodology and the package sits in
# /opt/orama/lib; in a checkout the package sits at the repository root. PYTHONPATH is set here,
# never inherited, and -s ignores user site-packages. -P (Python 3.11+) keeps the working directory off
# sys.path: the image starts in /work, the volume the untrusted run pod writes, so without it a
# planted orama_methodology/ or json.py would run in the stage or collect pod next to the run's
# credential (methodology-runtime#4).
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$root/lib/orama_methodology" ]; then lib="$root/lib"; else lib="$root"; fi
PYTHONPATH="$lib" exec python3 -P -s -m orama_methodology "$@"
